# AutoDoc_2026-09-01/.env.example
# Copie para a raiz como .env e preencha somente o necessário.
# NUNCA versionar credenciais reais.

# DeepSeek real API (opcional para desenvolvimento local; necessário para demos/e2e reais)
DEEPSEEK_API_KEY=

# Endpoint alternativo DeepSeek/OpenAI-compatible. Vazio = default público do adapter.
DEEPSEEK_BASE_URL=

# Harness home. Vazio = resolução padrão da plataforma/superfície.
# Exemplo local: /home/user/.dsh
DSH_HOME=

# Opt-in de apresentação/modo de tools quando a composição consumir esta variável.
DSH_TOOLS_MODE=

# Executável/comando do navegador usado pelo handoff automático.
# O Web bundle lê BROWSER apenas do ambiente herdado.
BROWSER=

# Não definir DSH_WEB_URL aqui: ele é publicado/gerenciado pelo runtime Web.
